{
  "name": "Cue",
  "short_name": "Cue",
  "description": "Chord and lyric app for live performance.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#4f46e5",
  "theme_color": "#4f46e5",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    { "src": "/cue-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/cue-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/cue-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
